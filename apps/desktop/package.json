{
  "name": "@pi-gui/desktop",
  "private": true,
  "version": "0.1.0",
  "author": "Matthew Lam",
  "license": "MIT",
  "description": "Codex-style desktop shell for pi",
  "main": "out/main/main.js",
  "scripts": {
    "build:deps": "pnpm --dir ../.. --filter @pi-gui/session-driver --filter @pi-gui/pi-sdk-driver --filter @pi-gui/catalogs run build",
    "build:notification-helper": "node scripts/build-notification-status-helper.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:deps && pnpm run build:notification-helper && electron-vite build",
    "preview": "pnpm run build:deps && pnpm run build:notification-helper && electron-vite preview",
    "start": "pnpm run preview",
    "package": "pnpm run package:mac",
    "package:mac": "pnpm run build && electron-builder --mac",
    "package:mac:dir": "pnpm run build && electron-builder --mac --dir",
    "package:win": "pnpm run build && electron-builder --win",
    "package:win:dir": "pnpm run build && electron-builder --win --dir",
    "package:linux": "pnpm run build && electron-builder --linux AppImage",
    "package:linux:dir": "pnpm run build && electron-builder --linux --dir",
    "package:all": "pnpm run build && electron-builder --mac --win --linux",
    "package:dir": "pnpm run package:mac:dir",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "verify:runtime-model-registry": "node scripts/assert-runtime-model-registry.mjs",
    "verify:packaged-runtime-deps": "pnpm run verify:runtime-model-registry && node scripts/assert-packaged-runtime-deps.mjs",
    "verify:packaged-runtime-deps:linux": "pnpm run verify:runtime-model-registry && cross-env PI_APP_PACKAGE_PLATFORM=linux node scripts/assert-packaged-runtime-deps.mjs"
  },
  "dependencies": {
    "@aws-sdk/token-providers": "^3.1036.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@pi-gui/pi-sdk-driver": "workspace:*",
    "@pi-gui/session-driver": "workspace:*",
    "@smithy/is-array-buffer": "^2.2.0",
    "@smithy/util-buffer-from": "^2.2.0",
    "@smithy/util-utf8": "^2.3.0",
    "ansi-regex": "^6.2.2",
    "balanced-match": "^4.0.2",
    "brace-expansion": "^5.0.2",
    "chalk": "^5.5.0",
    "data-uri-to-buffer": "^4.0.1",
    "glob": "^13.0.1",
    "hosted-git-info": "^9.0.2",
    "lru-cache": "^11.1.0",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.3",
    "node-pty": "^1.1.0",
    "parse5": "^5.1.1",
    "parse5-htmlparser2-tree-adapter": "^6.0.1",
    "proxy-agent": "^6.5.0",
    "retry": "^0.13.1",
    "strip-ansi": "^7.2.0",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
